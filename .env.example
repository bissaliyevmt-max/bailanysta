# Строка подключения к PostgreSQL.
# Локально:  postgresql://bailanysta:bailanysta@127.0.0.1:5432/bailanysta
# Neon:      postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
DATABASE_URL="postgresql://bailanysta:bailanysta@127.0.0.1:5432/bailanysta"

# Ключ OpenAI для генерации текста постов.
# НЕОБЯЗАТЕЛЬНЫЙ: без него генерация работает на встроенном офлайн-генераторе.
# Переменная без префикса NEXT_PUBLIC_ — значит она доступна ТОЛЬКО на сервере
# и физически не попадает в бандл браузера.
OPENAI_API_KEY=""

# Модель, которую использует эндпоинт /api/ai/generate
OPENAI_MODEL="gpt-4o-mini"
